# Google Gemini API — used for image enhancement (Imagen / "Nano Banana") and
# Veo image-to-video generation. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# TikTok Developer app credentials (Login Kit + Content Posting API).
# Create an app at https://developers.tiktok.com/apps and request the
# user.info.basic and video.publish scopes.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your TikTok app, e.g.
# https://your-domain.com/api/tiktok/oauth/callback
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/oauth/callback

# Public base URL of this app (used for a few redirects).
APP_URL=http://localhost:3000
